# Copie para .env (ou defina como variáveis de ambiente reais na VM/systemd) e preencha
# com valores de produção. Nunca commitar o .env real.

# Porta do backend. Obrigatório -- sem isso sobe na 3000 e o frontend (VITE_API_URL) não acha a API.
PORT=3101

# Connection string do Postgres (Supabase). Em produção (Vercel), usar SEMPRE a connection
# string do POOLER (porta 6543, host "...pooler.supabase.com", modo transaction) -- a conexão
# direta (porta 5432) esgota rápido sob serverless. Em dev local, a conexão direta funciona bem.
DATABASE_URL=

# PIN mestre do /admin (separado do login de usuário). Mínimo 6 caracteres.
# Sem isso, o servidor gera um PIN aleatório a cada boot (log do backend mostra qual) --
# NUNCA usar um PIN previsível (ex.: 123456, o valor usado só em dev local) em produção.
ADMIN_PIN=

# Origens (frontend) autorizadas a chamar a API, separadas por vírgula. Sem isso, cai no
# default de dev (http://localhost:5183) -- não serve para produção.
# Ex.: CORS_ORIGINS=https://webcrm.evertec.com.br
CORS_ORIGINS=

# SMTP para envio real do convite/recuperação de senha por e-mail.
# Sem essas variáveis, o link só é logado no console do backend e devolvido na resposta da API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Validade da sessão de login do app principal, em dias. Padrão 5 se omitido.
SESSION_TTL_DIAS=5
