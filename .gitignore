backend/scripts/sql-2026-08-28-indices/04_backfill_precheck.sql
backend/scripts/sql-2026-08-28-indices/05_backfill_ult_reajuste.sql
backend/scripts/sql-2026-08-28-indices/06_diagnostico.sql

# Config local de preview desta máquina (caminhos e PIN de dev específicos daqui)
.claude/

# Cache local do Firebase CLI (gerado a cada deploy, não faz parte do código)
frontend/.firebase/

# Editor/SO
.vscode/*
